# ===== 数据库 =====
DATABASE_URL=postgresql://roleplay:roleplay@localhost:5432/roleplay
TEST_DATABASE_URL=postgresql://roleplay:roleplay@localhost:5432/roleplay_test

# ===== LLM 对话/摘要（M1 起需要，暂时占位）=====
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== Embedding（M2 起需要，维度已定死 1024，见方案 3.6）=====
# 仅压测/单测可用 EMBEDDING_PROVIDER=fake（确定性哈希向量，不加载模型；生产不得使用）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMS=1024

# ===== 记忆（V2.3；以下均为默认值，按需取消注释覆盖）=====
# 摘要阈值与近轮窗口对齐（D9）：trigger 必须 <= PROMPT_RECENT_ROUNDS，否则配第 11-20 轮空窗
#PROMPT_RECENT_ROUNDS=10
#SUMMARY_TRIGGER_ROUNDS=10
#SUMMARY_CHUNK_ROUNDS=10
# 事实抽取总开关；false = 行为逐字退回 V2.2（不调 LLM、不写新条目、prompt 不变）
#MEMORY_EXTRACT_ENABLED=true
#MEMORY_EXTRACT_MIN_CHARS=8
#MEMORY_EXTRACT_TIMEOUT_S=8
# 冲突处理：overwrite（旧条目标 superseded_at）/ keep_both_with_note（双保留 + 「（你以前说 X）」）
#MEMORY_FACT_MODE=overwrite
#MEMORY_FACT_LIMIT=200
# 四槽位档案（称呼 / 禁忌 / 关系阶段 / 重要日期）常驻注入，不走向量召回
#MEMORY_PROFILE_ENABLED=true
#MEMORY_PROFILE_RATIO=0.10
# 加权召回：0.6*cos + 0.25*recency + 0.15*importance；false = 纯余弦（消融）
#MEMORY_WEIGHTED_RECALL=true
#MEMORY_W_COSINE=0.6
#MEMORY_W_RECENCY=0.25
#MEMORY_W_IMPORTANCE=0.15
#MEMORY_RECENCY_HALFLIFE_DAYS=14
#MEMORY_RECALL_OVERSCAN=50
#MEMORY_RECALL_LIMIT=5
# L2 层级摘要：每 MEMORY_L2_EVERY_MERGES 次 L1 滚动合并重合成一次（<=300 字，私聊/群聊共用）
#MEMORY_L2_ENABLED=true
#MEMORY_L2_RATIO=0.05
#MEMORY_L2_EVERY_MERGES=3
#MEMORY_L2_MAX_CHARS=300

# ===== 可观测（V2.4；以下均为默认值）=====
# TRACE_ENABLED=false 时不写 trace 文件（主流程不受影响）；写失败一律 fail-open
#TRACE_ENABLED=true
#TRACE_DIR=data/traces
#TRACE_SAMPLE_RATE=1.0
#TRACE_MAX_FIELD_CHARS=200
# 观察 C-03 群聊 namespace 增长用；true 时每轮多一次 asearch(limit=1000)，默认关闭
#TRACE_MEMORY_STATS=false
#PROMPT_VERSION=v2.6
# 内心独白补写：整轮漏写时多一次完整 prompt 调用（默认开，成本敏感可关）
#REPLY_THINK_RETRY_ENABLED=true

# ===== 成本（V2.4）=====
# 价格为示例值（deepseek-chat 当期牌价量级），部署必须按实际账单覆盖
#LLM_PRICE_INPUT_CNY_PER_1M=2.0
#LLM_PRICE_OUTPUT_CNY_PER_1M=8.0

# ===== 稳定性（V2.4）=====
# 全局 LLM 并发上限（asyncio.Semaphore）与单次调用超时兜底（秒）
#LLM_MAX_CONCURRENCY=8
#LLM_TIMEOUT_S=30
# 超时/失败时返回的降级文本（该轮标记 degraded，不写记忆）
#LLM_TIMEOUT_FALLBACK=（我这边有点走神，稍等一下再说。）
# 数据库连接池（checkpointer + store 共用）；上限应 >= 并发 SSE 连接数，否则请求排队取连接
#DB_POOL_MIN_SIZE=4
#DB_POOL_MAX_SIZE=20
# 提醒 pending 惰性 TTL：超过该小时数的 pending 在 list/confirm 时被置 cancelled
#REMINDER_PENDING_TTL_HOURS=24
# 非流式 /chat 幂等缓存（单进程内存；SSE 不做幂等）
#CHAT_IDEMPOTENCY_TTL_S=600
#CHAT_IDEMPOTENCY_MAX_ENTRIES=1024

# ===== 压测（V2.4 · 仅 fake，禁止用于生产）=====
# LLM_PROVIDER=fake 时生效；压测只允许 fake，0 真实 token
# 压测建议同时设 EMBEDDING_PROVIDER=fake、LORE_ENABLED=false、独立 TRACE_DIR（见 README）
#FAKE_LLM_DELAY_MS=10
#FAKE_LLM_REPLY=（压测假回复）
